# Copy to .env only after a signed partner agreement exists.
# Never put live keys in git. These names document the legitimate rails —
# they do not enable trading by themselves.

# Read-only aggregation (OAuth / FDX). Not a trade API.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Brokerage connectivity. Workplace 401(k)/HSA links are read-only at Fidelity, Empower, Schwab, TIAA, Vanguard.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# New HSA investing sleeve. Requires DriveWealth introducing-broker or RIA contract PLUS an IRS-qualified HSA trustee.
DRIVEWEALTH_APP_KEY=
DRIVEWEALTH_APP_SECRET=
DRIVEWEALTH_ENV=sandbox

# Embedded HSA administrator (B2B). Not a consumer "connect my Fidelity HSA" API.
FIRST_DOLLAR_API_KEY=
ALEGEUS_TPA_ID=
