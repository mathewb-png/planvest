{
  "name": "planvest",
  "version": "0.1.0",
  "private": true,
  "description": "Compliance-first HSA and 401(k) investing toolkit. Market access is blocked unless a licensed custody rail is in place.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test src/gates.test.ts src/hsaLimits.test.ts src/allocation.test.ts src/sma.test.ts",
    "typecheck": "tsc --noEmit",
    "matrix": "node --experimental-strip-types src/printMatrix.ts",
    "market": "node --experimental-strip-types scripts/fetchMarket.ts",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1"
  }
}
